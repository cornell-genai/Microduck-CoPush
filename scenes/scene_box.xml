<mujoco model="scene_copush_box">
    <!-- CoPush Week 1 scene: microduck_rl's scene_backlash.xml (duck-sim's default floor, whose
         robot carries the joint backlash velstand was trained with) + one free-joint box.

         Installed by scripts/install_scene.sh into microduck_rl/src/mjlab_microduck/robot/microduck/
         as scene_copush_box.xml (untracked), because the <include> below is relative.

         Box: 28 x 10 x 9 cm (half-sizes 0.14 0.05 0.045), 150 g, i.e. the Shoe Push box
         (pisdeburra/robert-policies). Centre 0.6 m ahead of duck A (world +x is duck A's forward at
         spawn), resting on the floor (z = 0.045), yawed 90 deg so its 28 cm face spans world y and
         faces the ducks. Duck A spawns at (0, 0), duck B at (0, 0.5) (body_server.SPACING), so the
         box is clear of both until someone walks into it.

         Friction is MuJoCo's default (1, 0.005, 0.0001), as in scenes/scene_b0_*.xml; the
         floor is also mu=1, and MuJoCo takes the max of the pair. contype/conaffinity default 1/1:
         it collides with the floor and with the robots' contype-1 geoms.

         No keyframes: the box free joint changes nq, so the robot's keyframes would not fit (see
         the comment in scene_ball.xml). Launch with DUCK_SIM_KEYFRAME=HOME, which body_server's
         pose_table handles without a keyframe. -->
    <include file="robot_groundcontact_backlash.xml" />

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
        <rgba haze="0.15 0.25 0.35 1" />
        <global azimuth="160" elevation="-20" />
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512"
            height="3072" />
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
            rgb2="0.1 0.2 0.3"
            markrgb="0.8 0.8 0.8" width="300" height="300" />
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"
            reflectance="0.2" />
    </asset>

    <worldbody>
        <light pos="0 0 3.5" dir="0 0 -1" directional="true" />
        <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane" material="groundplane" />
        <body name="box" pos="0.6 0 0.045" quat="0.70710678 0 0 0.70710678">
            <freejoint name="box_free" />
            <geom name="box_geom" type="box" size="0.14 0.05 0.045" mass="0.15"
                rgba="0.75 0.45 0.2 1" />
        </body>
    </worldbody>
</mujoco>
