<mujoco model="scene_copush_b0_backward">
    <!-- CoPush B0 (one duck, Shoe Push backward policy): the robot + one free-joint box centred
         0.20 m BEHIND the trunk.

         Installed by scripts/install_scene.sh into microduck_rl/src/mjlab_microduck/robot/microduck/
         as scene_copush_b0_backward.xml (untracked), because the <include> below is relative. The
         installer also writes scene_copush_b0_backward_nobacklash.xml, the same scene on
         robot_groundcontact.xml (no joint backlash), which is what the first B0 report used.

         Robot: robot_groundcontact_backlash.xml, as duck-sim's default scene and scene_box.xml.
         velstand was trained with backlash and barely walks without it (microduck
         docs/design/simulation.md section 11).

         Robot forward = world +x at spawn (infer_policy.py puts the trunk at (0, 0, 0.125),
         identity quat). Box: 28 x 10 x 9 cm (half-sizes 0.14 0.05 0.045), 150 g (eval_push.py
         re-randomizes mass and yaw per trial), centre x = -0.20, resting on the floor (z = 0.045),
         yawed 90 deg so the 28 cm face spans world y and faces the robot; near face at x = -0.15.
         Friction: MuJoCo default, as scene_box.xml. No keyframes: the box free joint changes nq. -->
    <include file="robot_groundcontact_backlash.xml" />

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
        <rgba haze="0.15 0.25 0.35 1" />
        <global azimuth="160" elevation="-20" />
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512"
            height="3072" />
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
            rgb2="0.1 0.2 0.3"
            markrgb="0.8 0.8 0.8" width="300" height="300" />
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"
            reflectance="0.2" />
    </asset>

    <worldbody>
        <light pos="0 0 3.5" dir="0 0 -1" directional="true" />
        <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane" material="groundplane" />
        <body name="box" pos="-0.20 0 0.045" quat="0.70710678 0 0 0.70710678">
            <freejoint name="box_free" />
            <geom name="box_geom" type="box" size="0.14 0.05 0.045" mass="0.15"
                rgba="0.75 0.45 0.2 1" />
        </body>
    </worldbody>
</mujoco>
